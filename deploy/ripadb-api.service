[Unit]
Description=ripadb API server
After=network.target postgresql.service

[Service]
Type=simple
User=ripadb
Group=ripadb
WorkingDirectory=/opt/ripadb/api
EnvironmentFile=/etc/ripadb/env
ExecStart=/var/lib/ripadb/.local/bin/uv run --frozen uvicorn src.app:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5

StandardOutput=append:/var/log/ripadb/ripadb-server.log
StandardError=append:/var/log/ripadb/ripadb-server.log

# Hardening
NoNewPrivileges=true
ProtectHome=tmpfs
ReadWritePaths=/var/lib/ripadb /var/log/ripadb
ProtectSystem=strict
PrivateTmp=true
ReadOnlyPaths=/opt/ripadb

[Install]
WantedBy=multi-user.target
